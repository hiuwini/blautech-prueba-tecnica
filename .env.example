# PostgreSQL
POSTGRES_DB=regulatory_platform
POSTGRES_USER=regulatory_user
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB
MONGO_URI=mongodb://mongo:27017/regulatory_audit
MONGO_DATABASE=regulatory_audit
MONGO_PORT=27017

# MinIO / S3-compatible local storage
MINIO_ROOT_USER=local_minio_user
MINIO_ROOT_PASSWORD=change_me_local_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=regulatory-documents
MINIO_ACCESS_KEY=local_minio_user
MINIO_SECRET_KEY=change_me_local_minio_password
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Services
FRONTEND_PORT=3000
DOCUMENT_PROCESSING_HOST=0.0.0.0
DOCUMENT_PROCESSING_PORT=8000
DOCUMENT_PROCESSING_CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCUMENT_PROCESSING_PRESIGNED_URL_EXPIRY_SECONDS=900
MOCK_SOAP_PORT=8090
SOAP_GATEWAY_HOST=0.0.0.0
SOAP_GATEWAY_PORT=8001
SOAP_GATEWAY_TIMEOUT_SECONDS=5
MOCK_SOAP_TIMEOUT_SECONDS=5
BFF_HOST=0.0.0.0
BFF_PORT=4000
BFF_CORS_ALLOWED_ORIGINS=
BFF_FASTAPI_TIMEOUT_SECONDS=3
BFF_DASHBOARD_PAGE_SIZE=100
BFF_DASHBOARD_MAX_DOCUMENTS=500
BFF_WEBHOOK_URL=http://bff-notifications:4000/api/v1/webhooks/processing-complete
BFF_WEBHOOK_TIMEOUT_SECONDS=3

# Service-to-service URLs for Docker Compose. Use localhost overrides only when
# running services directly on the host.
FASTAPI_BASE_URL=http://document-processing:8000
SOAP_GATEWAY_BASE_URL=http://soap-gateway:8001
MOCK_SOAP_BASE_URL=http://mock-soap-server:8090
BFF_BASE_URL=http://bff-notifications:4000
FRONTEND_BASE_URL=http://localhost:3000
SOCKET_IO_NAMESPACE=/notifications

# Frontend browser URLs. These are evaluated by Vite at build time.
VITE_DOCUMENT_PROCESSING_BASE_URL=http://localhost:8000
VITE_BFF_BASE_URL=http://localhost:4000
VITE_SOCKET_IO_NAMESPACE=/notifications
